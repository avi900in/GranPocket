# For Local Vite Development (Insecure, exposes to browser):
# VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
# VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# VITE_TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# For Vercel Production (Secure, uses /api backend):
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here
GROQ_API_KEY=your_groq_api_key_here

# Tencent RTC (TRTC) Conversational AI Configurations
# https://trtc.io/ and Tencent Cloud Console
TRTC_SDK_APP_ID=your_trtc_sdk_app_id
TRTC_SECRET_KEY=your_trtc_secret_key_for_usersig
TENCENTCLOUD_SECRET_ID=your_tencentcloud_secret_id
TENCENTCLOUD_SECRET_KEY=your_tencentcloud_secret_key
TENCENTCLOUD_REGION=ap-singapore

